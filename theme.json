{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "color": "#1a1a2e", "name": "Primary" },
        { "slug": "secondary", "color": "#16213e", "name": "Secondary" },
        { "slug": "accent", "color": "#e94560", "name": "Accent" },
        { "slug": "accent-alt", "color": "#6c5ce7", "name": "Accent Alt" },
        { "slug": "warm", "color": "#f59e0b", "name": "Warm" },
        { "slug": "teal", "color": "#0d9488", "name": "Teal" },
        { "slug": "sky", "color": "#0ea5e9", "name": "Sky" },
        { "slug": "rose", "color": "#f43f5e", "name": "Rose" },
        { "slug": "light", "color": "#f8f9fa", "name": "Light" },
        { "slug": "light-warm", "color": "#fef3c7", "name": "Light Warm" },
        { "slug": "light-accent", "color": "#fce4ec", "name": "Light Accent" },
        { "slug": "surface", "color": "#ffffff", "name": "Surface" },
        { "slug": "muted", "color": "#6c757d", "name": "Muted" },
        { "slug": "border", "color": "#e9ecef", "name": "Border" },
        { "slug": "dark", "color": "#212529", "name": "Dark" },
        { "slug": "dark-soft", "color": "#495057", "name": "Dark Soft" }
      ],
      "gradients": [
        {
          "slug": "primary-to-secondary",
          "gradient": "linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)",
          "name": "Primary to Secondary"
        },
        {
          "slug": "accent-warm",
          "gradient": "linear-gradient(135deg, #e94560 0%, #f59e0b 100%)",
          "name": "Accent Warm"
        },
        {
          "slug": "purple-pink",
          "gradient": "linear-gradient(135deg, #6c5ce7 0%, #e94560 100%)",
          "name": "Purple Pink"
        },
        {
          "slug": "teal-sky",
          "gradient": "linear-gradient(135deg, #0d9488 0%, #0ea5e9 100%)",
          "name": "Teal Sky"
        },
        {
          "slug": "warm-rose",
          "gradient": "linear-gradient(135deg, #f59e0b 0%, #f43f5e 100%)",
          "name": "Warm Rose"
        },
        {
          "slug": "header-gradient",
          "gradient": "linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0d9488 100%)",
          "name": "Header Gradient"
        },
        {
          "slug": "subtle-light",
          "gradient": "linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%)",
          "name": "Subtle Light"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'JetBrains Mono', 'SF Mono', 'Cascadia Code', 'Fira Code', 'Consolas', monospace",
          "slug": "jetbrains-mono",
          "name": "JetBrains Mono",
          "fontFace": [
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKxjPVmUsaaDhw.woff2"]
            },
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "500",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKxTPVmUsaaDhw.woff2"]
            },
            {
              "fontFamily": "JetBrains Mono",
              "fontWeight": "700",
              "fontStyle": "normal",
              "src": ["https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKxjOlmUsaaDhw.woff2"]
            }
          ]
        },
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
          "slug": "system",
          "name": "System"
        },
        {
          "fontFamily": "'Georgia', 'Times New Roman', serif",
          "slug": "serif",
          "name": "Serif"
        },
        {
          "fontFamily": "'SF Mono', 'Cascadia Code', 'Fira Code', 'Consolas', monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "size": "0.75rem", "name": "Extra Small", "fluid": { "min": "0.7rem", "max": "0.75rem" } },
        { "slug": "small", "size": "0.8125rem", "name": "Small", "fluid": { "min": "0.75rem", "max": "0.8125rem" } },
        { "slug": "medium", "size": "0.9375rem", "name": "Medium", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
        { "slug": "large", "size": "1.0625rem", "name": "Large", "fluid": { "min": "1rem", "max": "1.0625rem" } },
        { "slug": "x-large", "size": "1.25rem", "name": "Extra Large", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
        { "slug": "xx-large", "size": "1.625rem", "name": "Huge", "fluid": { "min": "1.375rem", "max": "1.625rem" } },
        { "slug": "xxx-large", "size": "2rem", "name": "Gigantic", "fluid": { "min": "1.625rem", "max": "2rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "size": "0.25rem", "name": "1" },
        { "slug": "20", "size": "0.5rem", "name": "2" },
        { "slug": "30", "size": "1rem", "name": "3" },
        { "slug": "40", "size": "1.5rem", "name": "4" },
        { "slug": "50", "size": "2rem", "name": "5" },
        { "slug": "60", "size": "3rem", "name": "6" },
        { "slug": "70", "size": "4rem", "name": "7" },
        { "slug": "80", "size": "6rem", "name": "8" }
      ]
    },
    "shadow": {
      "presets": [
        { "slug": "sm", "shadow": "0 1px 2px rgba(0,0,0,0.06)", "name": "Small" },
        { "slug": "md", "shadow": "0 4px 6px rgba(0,0,0,0.07)", "name": "Medium" },
        { "slug": "lg", "shadow": "0 10px 15px rgba(0,0,0,0.1)", "name": "Large" },
        { "slug": "xl", "shadow": "0 20px 25px rgba(0,0,0,0.1)", "name": "Extra Large" },
        { "slug": "card", "shadow": "0 2px 8px rgba(26,26,46,0.08)", "name": "Card" },
        { "slug": "card-hover", "shadow": "0 8px 24px rgba(26,26,46,0.12)", "name": "Card Hover" },
        { "slug": "accent-glow", "shadow": "0 4px 14px rgba(233,69,96,0.25)", "name": "Accent Glow" }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--dark)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--jetbrains-mono)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--30)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--30)"
      },
      "blockGap": "var(--wp--preset--spacing--40)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--jetbrains-mono)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-alt)"
          },
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--surface)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "0.75em",
            "right": "1.5em",
            "bottom": "0.75em",
            "left": "1.5em"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      },
      "caption": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--dark)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/post-date": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/post-excerpt": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.8"
        },
        "color": {
          "text": "var(--wp--preset--color--muted)"
        }
      },
      "core/query-pagination": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--mono)",
          "fontSize": "var(--wp--preset--font-size--small)"
        },
        "color": {
          "background": "var(--wp--preset--color--light)",
          "text": "var(--wp--preset--color--primary)"
        },
        "border": {
          "radius": "6px"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--40)",
            "right": "var(--wp--preset--spacing--40)",
            "bottom": "var(--wp--preset--spacing--40)",
            "left": "var(--wp--preset--spacing--40)"
          }
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--accent)",
            "width": "3px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--40)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontStyle": "italic"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        },
        "border": {
          "color": "currentColor",
          "width": "0 0 1px 0",
          "style": "solid"
        }
      },
      "core/tag-cloud": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/categories": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/latest-posts": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "sidebar", "title": "Sidebar", "area": "uncategorized" },
    { "name": "comments", "title": "Comments", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (No Title)", "postTypes": ["page"] },
    { "name": "page-wide", "title": "Page (Wide)", "postTypes": ["page"] }
  ]
}