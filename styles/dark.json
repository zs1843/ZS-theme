{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Dark",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#e2e8f0", "name": "Primary" },
        { "slug": "secondary", "color": "#94a3b8", "name": "Secondary" },
        { "slug": "accent", "color": "#f472b6", "name": "Accent" },
        { "slug": "accent-alt", "color": "#a78bfa", "name": "Accent Alt" },
        { "slug": "warm", "color": "#fbbf24", "name": "Warm" },
        { "slug": "teal", "color": "#2dd4bf", "name": "Teal" },
        { "slug": "sky", "color": "#38bdf8", "name": "Sky" },
        { "slug": "rose", "color": "#fb7185", "name": "Rose" },
        { "slug": "light", "color": "#1e293b", "name": "Light" },
        { "slug": "light-warm", "color": "#292524", "name": "Light Warm" },
        { "slug": "light-accent", "color": "#3b1f2b", "name": "Light Accent" },
        { "slug": "surface", "color": "#0f172a", "name": "Surface" },
        { "slug": "muted", "color": "#94a3b8", "name": "Muted" },
        { "slug": "border", "color": "#334155", "name": "Border" },
        { "slug": "dark", "color": "#f1f5f9", "name": "Dark" },
        { "slug": "dark-soft", "color": "#cbd5e1", "name": "Dark Soft" }
      ],
      "gradients": [
        {
          "slug": "primary-to-secondary",
          "gradient": "linear-gradient(135deg, #1e293b 0%, #0f172a 100%)",
          "name": "Primary to Secondary"
        },
        {
          "slug": "accent-warm",
          "gradient": "linear-gradient(135deg, #f472b6 0%, #a855f7 100%)",
          "name": "Accent Warm"
        },
        {
          "slug": "purple-pink",
          "gradient": "linear-gradient(135deg, #a78bfa 0%, #f472b6 100%)",
          "name": "Purple Pink"
        },
        {
          "slug": "teal-sky",
          "gradient": "linear-gradient(135deg, #2dd4bf 0%, #38bdf8 100%)",
          "name": "Teal Sky"
        },
        {
          "slug": "warm-rose",
          "gradient": "linear-gradient(135deg, #fbbf24 0%, #fb7185 100%)",
          "name": "Warm Rose"
        },
        {
          "slug": "header-gradient",
          "gradient": "linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #164e63 100%)",
          "name": "Header Gradient"
        },
        {
          "slug": "subtle-light",
          "gradient": "linear-gradient(180deg, #1e293b 0%, #0f172a 100%)",
          "name": "Subtle Light"
        }
      ]
    },
    "shadow": {
      "presets": [
        { "slug": "sm", "shadow": "0 1px 2px rgba(0,0,0,0.3)", "name": "Small" },
        { "slug": "md", "shadow": "0 4px 6px rgba(0,0,0,0.35)", "name": "Medium" },
        { "slug": "lg", "shadow": "0 10px 15px rgba(0,0,0,0.4)", "name": "Large" },
        { "slug": "xl", "shadow": "0 20px 25px rgba(0,0,0,0.4)", "name": "Extra Large" },
        { "slug": "card", "shadow": "0 2px 8px rgba(0,0,0,0.3)", "name": "Card" },
        { "slug": "card-hover", "shadow": "0 8px 24px rgba(0,0,0,0.4)", "name": "Card Hover" },
        { "slug": "accent-glow", "shadow": "0 4px 14px rgba(244,114,182,0.3)", "name": "Accent Glow" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--dark)"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent-alt)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "#0f172a"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent-alt)",
            "text": "#0f172a"
          }
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--primary)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            "color": {
              "text": "var(--wp--preset--color--dark)"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--accent)"
              }
            }
          }
        }
      },
      "core/code": {
        "color": {
          "background": "var(--wp--preset--color--light)",
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--border)"
        }
      }
    }
  }
}